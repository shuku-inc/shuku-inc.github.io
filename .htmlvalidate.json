{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "warn",
    "require-sri": "off",
    "long-title": "warn",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "doctype-style": "off",
    "void-style": "off"
  }
}
