{
  "ci": {
    "collect": {
      "url": ["http://localhost:8081/", "http://localhost:8081/about/"],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      },
      "startServerCommand": "npx http-server . -p 8081",
      "startServerReadyPattern": "Available on"
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
